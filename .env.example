# Pick ONE provider. If LLM_PROVIDER is empty, the first key found is used: claude > groq > gemini.
# LLM_PROVIDER=groq

# Groq — free tier, no card (console.groq.com → API Keys)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini via AI Studio — free tier (aistudio.google.com → Get API key)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Claude — paid API credits (console.anthropic.com). A Claude Max/Pro subscription does NOT include API credits.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# Ollama — local, free (ollama.com)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

PORT=3000
